<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.colin.mapper.FileMapper">

    <resultMap id="BaseResultMap" type="cn.colin.common.entity.File">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="file_name" property="fileName" jdbcType="VARCHAR"/>
        <result column="file_path" property="filePath" jdbcType="VARCHAR"/>
        <result column="file_size" property="fileSize" jdbcType="BIGINT"/>
        <result column="content_type" property="contentType" jdbcType="VARCHAR"/>
        <result column="bucket_name" property="bucketName" jdbcType="VARCHAR"/>
        <result column="parent_id" property="parentId" jdbcType="BIGINT"/>
        <result column="is_folder" property="isFolder" jdbcType="TINYINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 根据存储桶名称和父文件夹ID查询文件列表 -->
    <select id="selectFileListByParentId" resultMap="BaseResultMap">
        SELECT * FROM sys_file
        WHERE bucket_name = #{bucketName}
          AND parent_id = #{parentId}
        ORDER BY is_folder DESC, file_name ASC
    </select>

    <!-- 根据存储桶名称和搜索关键字查询文件列表 -->
    <select id="selectFileListByKeyword" resultMap="BaseResultMap">
        SELECT * FROM sys_file
        WHERE bucket_name = #{bucketName}
          AND parent_id = #{parentId}
          AND file_name LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY is_folder DESC, file_name ASC
    </select>

    <!-- 查询文件夹列表 -->
    <select id="selectFolderList" resultMap="BaseResultMap">
        SELECT * FROM sys_file
        WHERE bucket_name = #{bucketName}
          AND parent_id = #{parentId}
          AND is_folder = 1
        ORDER BY file_name ASC
    </select>

    <!-- 根据文件ID删除（物理删除） -->
    <delete id="deleteById">
        DELETE FROM sys_file WHERE id = #{id}
    </delete>

    <!-- 根据文件ID列表批量删除 -->
    <delete id="deleteByIds">
        DELETE FROM sys_file WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 移动文件到目标文件夹 -->
    <update id="moveFile">
        UPDATE sys_file
        SET parent_id = #{targetParentId}
        WHERE id = #{fileId}
    </update>

    <!-- 检查同级目录下是否存在同名文件 -->
    <select id="checkFileNameExists" resultType="Long">
        SELECT COUNT(*) FROM sys_file
        WHERE bucket_name = #{bucketName}
          AND parent_id = #{parentId}
          AND file_name = #{fileName}
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <!-- 获取文件夹下的子文件/文件夹数量 -->
    <select id="countChildren" resultType="Long">
        SELECT COUNT(*) FROM sys_file
        WHERE bucket_name = #{bucketName}
          AND parent_id = #{parentId}
    </select>

</mapper>